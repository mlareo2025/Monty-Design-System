{
  "name": "monty-storybook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Monty DS en código: tokens como variables CSS y componentes en React.",
  "scripts": {
    "tokens": "node scripts/tokens-to-css.mjs",
    "prestorybook": "npm run tokens",
    "storybook": "storybook dev -p 6006 --no-open",
    "prebuild-storybook": "npm run tokens",
    "build-storybook": "storybook build",
    "typecheck": "npm run tokens && tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.19",
    "@storybook/blocks": "8.6.19",
    "@storybook/react": "8.6.19",
    "@storybook/react-vite": "8.6.19",
    "@storybook/test": "8.6.19",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "storybook": "8.6.19",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
